{
  "name": "@nekm/svelte-core",
  "description": "Code I find myself re-writing over-and-over, Svelte edition.",
  "license": "MIT",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./svelte-kit-session-mongodb": {
      "types": "./dist/svelte-kit-session-mongodb/index.d.ts",
      "svelte": "./dist/svelte-kit-session-mongodb/index.js"
    }
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@types/node": "^25.5.0",
    "mongodb": "^7.1.1",
    "publint": "^0.3.18",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte-kit-sessions": "^0.4.0",
    "typescript": "^6",
    "vite": "^8.0.12",
    "vite-plugin-devtools-json": "^1.1.2"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@nekm/core": "1.*",
    "jose": "6.*"
  },
  "peerDependencies": {
    "@sveltejs/kit": "3.*",
    "mongodb": "7.*",
    "svelte": "5.*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "overrides": {
    "svelte-kit-sessions": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "optionalDependencies": {
    "svelte-kit-sessions": "0.4.*"
  }
}
